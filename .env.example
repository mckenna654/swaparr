# Copy to .env next to docker-compose.yml and fill in. Never commit the real .env.

# Port Swaparr listens on (host and container).
PORT=8080

# Dispatcharr address and API key (Dispatcharr -> Settings -> Users -> API Key).
DISPATCHARR_URL=http://192.168.1.100:9191
DISPATCHARR_API_KEY=your_api_key_here

# Optional watcher: records what happens while Swaparr is closed and can send alerts.
WATCHER=false
# Where alerts go, for example https://ntfy.sh/your-private-topic or an Apprise URL.
NOTIFY_URL=
# "text" for ntfy, "json" for Apprise, Home Assistant and other webhooks.
NOTIFY_FORMAT=text
